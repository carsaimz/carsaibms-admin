# Carsai BMS Admin — variáveis de ambiente
# Copie para .env e ajuste os valores.

# Base de dados (SQLite). O caminho é relativo à pasta prisma/.
DATABASE_URL=file:../db/custom.db

# Segredo para assinar os tokens de sessão (HMAC-SHA256).
# Gere um valor aleatório forte, ex.: openssl rand -hex 32
AUTH_SECRET=troque-este-segredo-em-producao
