// Carsai BMS Admin — Schema da base de dados
// Plataforma administrativa do Carsai Business Management System
// CarsaiDev — Uma linha, uma solução. 🇲🇿

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

// Utilizadores do painel administrativo (equipa Carsai)
model User {
  id           String    @id @default(cuid())
  name         String
  email        String    @unique
  passwordHash String
  role         String    @default("ADMIN") // SUPER_ADMIN | ADMIN | SUPPORT
  isActive     Boolean   @default(true)
  lastLoginAt  DateTime?
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt
}

// Planos de subscrição da plataforma
model Plan {
  id          String   @id @default(cuid())
  name        String
  slug        String   @unique
  description String?
  price       Float    @default(0)
  interval    String   @default("MONTHLY") // MONTHLY | YEARLY
  maxUsers    Int      @default(5)
  isPopular   Boolean  @default(false)
  isActive    Boolean  @default(true)
  sortOrder   Int      @default(0)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
  modules     PlanModule[]
  companies   Company[]
  invoices    Invoice[]
}

// Módulos do sistema BMS (activáveis por plano/empresa)
model Module {
  id          String   @id @default(cuid())
  key         String   @unique
  name        String
  description String?
  icon        String   @default("Package") // nome do ícone lucide-react
  category    String   @default("CORE")
  isCore      Boolean  @default(false)
  isActive    Boolean  @default(true)
  sortOrder   Int      @default(0)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
  plans       PlanModule[]
  companies   CompanyModule[]
}

// Módulos incluídos em cada plano
model PlanModule {
  planId   String
  moduleId String
  plan     Plan   @relation(fields: [planId], references: [id], onDelete: Cascade)
  module   Module @relation(fields: [moduleId], references: [id], onDelete: Cascade)

  @@id([planId, moduleId])
}

// Estado de activação de módulos por empresa
model CompanyModule {
  companyId String
  moduleId  String
  isEnabled Boolean   @default(false)
  enabledAt DateTime?
  company   Company @relation(fields: [companyId], references: [id], onDelete: Cascade)
  module    Module  @relation(fields: [moduleId], references: [id], onDelete: Cascade)

  @@id([companyId, moduleId])
}

// Empresas cliente da plataforma
model Company {
  id            String    @id @default(cuid())
  name          String
  slug          String    @unique
  email         String
  phone         String?
  nuit          String?
  address       String?
  city          String?
  province      String?
  status        String    @default("PENDING") // PENDING | ACTIVE | SUSPENDED | CANCELLED
  planId        String?
  plan          Plan?     @relation(fields: [planId], references: [id], onDelete: SetNull)
  licenseKey    String?   @unique
  licenseStatus String    @default("ACTIVE") // ACTIVE | REVOKED
  apiKey        String?   @unique
  apiKeyStatus  String    @default("ACTIVE") // ACTIVE | REVOKED
  maxUsers      Int       @default(5)
  expiresAt     DateTime?
  notes         String?
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt
  modules       CompanyModule[]
  instances     Instance[]
  invoices      Invoice[]
  webhooks      Webhook[]
}

// Instâncias do Carsai BMS instaladas pelos clientes (telemetria/heartbeat)
model Instance {
  id          String   @id @default(cuid())
  companyId   String
  company     Company  @relation(fields: [companyId], references: [id], onDelete: Cascade)
  instanceId  String   // identificador único da instalação (hostname/machine-id)
  appVersion  String?
  nodeVersion String?
  dbEngine    String?  // sqlite | postgres | mysql
  usersCount  Int?
  lastSeenAt  DateTime
  firstSeenAt DateTime @default(now())
  meta        String?  // JSON com dados extra reportados pelo BMS

  @@unique([companyId, instanceId])
  @@index([lastSeenAt])
}

// Facturas de subscrição da plataforma
model Invoice {
  id          String    @id @default(cuid())
  number      String    @unique // FT-2026-00001
  companyId   String
  company     Company   @relation(fields: [companyId], references: [id], onDelete: Cascade)
  planId      String?
  plan        Plan?     @relation(fields: [planId], references: [id], onDelete: SetNull)
  planName    String
  amount      Float
  currency    String    @default("MZN")
  periodStart DateTime
  periodEnd   DateTime
  issuedAt    DateTime  @default(now())
  dueAt       DateTime
  paidAt      DateTime?
  method      String?   // MPESA | TRANSFER | CASH | CARD
  status      String    @default("OPEN") // OPEN | PAID | OVERDUE | CANCELLED
  notes       String?
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  @@index([status])
  @@index([companyId])
}

// Webhooks por empresa (eventos da plataforma)
model Webhook {
  id          String    @id @default(cuid())
  companyId   String
  company     Company   @relation(fields: [companyId], references: [id], onDelete: Cascade)
  url         String
  events      String    @default("*") // CSV de eventos ou "*" para todos
  secret      String    // segredo HMAC-SHA256 usado na assinatura X-Carsai-Signature
  isActive    Boolean   @default(true)
  lastStatus  Int?      // último código HTTP devolvido pelo destino (null = erro de rede)
  lastFiredAt DateTime?
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt
}

// Registo de auditoria de acções sensíveis
model AuditLog {
  id         String   @id @default(cuid())
  action     String // LOGIN | LOGIN_FAILED | COMPANY_CREATED | COMPANY_UPDATED | COMPANY_DELETED | COMPANY_SUSPENDED | COMPANY_ACTIVATED | PLAN_CREATED | PLAN_UPDATED | PLAN_DELETED | MODULE_CREATED | MODULE_UPDATED | MODULE_ENABLED | MODULE_DISABLED | KEY_REGENERATED | KEY_REVOKED | USER_CREATED | USER_UPDATED | USER_DELETED | SETTING_UPDATED
  entityType String // Company | Plan | Module | User | Setting | Auth | CompanyModule
  entityId   String?
  entityName String?
  details    String?
  actorEmail String?
  createdAt  DateTime @default(now())
}

// Configurações do sistema (key-value)
model Setting {
  key         String @id
  value       String
  type        String @default("string") // string | number | boolean
  group       String @default("general") // general | access | system
  description String?
}
